{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./tests/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git commit:*)",
      "Bash(git commit --amend:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./node_modules/**)",
      "Edit(./.git/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); p=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\"; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*) if [ -x \"$p\" ]; then \"$p\" --write --ignore-unknown --log-level warn \"$f\"; fi;; esac"
          }
        ]
      }
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
